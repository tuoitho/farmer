# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=nong_dan_ai

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Weather API Configuration
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.weatherapi.com/v1

# n8n Webhook
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/weather

# Clova Studio API Configuration
CLOVA_STUDIO_API_KEY=your-clova-studio-api-key
CLOVA_STUDIO_REQUEST_ID=your-request-id

# Application Configuration
APP_NAME=NÔNG DÂN AI
APP_VERSION=1.0.0
DEBUG=False

# CORS Configuration
CORS_ORIGINS=["*"]

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=nong-dan-ai/farms
